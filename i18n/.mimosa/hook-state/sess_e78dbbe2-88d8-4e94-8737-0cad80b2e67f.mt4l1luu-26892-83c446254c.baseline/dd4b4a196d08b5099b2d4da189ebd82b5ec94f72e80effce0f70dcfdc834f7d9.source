      /* index — faq */
      "faq.eyebrow": "ಸಾಮಾನ್ಯ ಪ್ರಶ್ನೆಗಳು",
      "faq.title": "ಪ್ರಶ್ನೆಗಳಿಗೆ ಸರಳ ಉತ್ತರ.",
      "faq.q0":
        "FRRO ವೆಬ್‌ಸೈಟ್‌ನಲ್ಲೇ ಫಾರ್ಮ್ ಭರ್ತಿ ಮಾಡಬಹುದಿದ್ದರೆ ಈ ಅಪ್ಲಿಕೇಶನ್ ಯಾಕೆ ಬೇಕು?",
      "faq.a0":
        "ಮಾಡಬಹುದು — FRRO ಎರಡನ್ನೂ ಸ್ವೀಕರಿಸಲೇಬೇಕು. ಆದರೆ ಪೋರ್ಟಲ್ ನಿಧಾನ ಮತ್ತು ಕ್ಷಮಿಸದ ಸ್ವಭಾವದ್ದು: ಹಲವಾರು ಫೀಲ್ಡ್‌ಗಳನ್ನು ಟ್ಯಾಬ್‌ಗಳಾಗಿ ಹರಡಿ, ಗಟ್ಟಿಯಾದ 24-ಗಂಟೆಗಳ ಗಡುವಿನಡಿ ಟೈಪ್ ಮಾಡಿಸುತ್ತದೆ. ಕೈಯಿಂದ ಮಾಡುವ ದಾರಿ ಸಮಯ ವ್ಯರ್ಥ ಮಾಡುತ್ತದೆ ಹಾಗೂ ಟೈಪ್ ತಪ್ಪುಗಳನ್ನು ಆಹ್ವಾನಿಸುತ್ತದೆ — ಅದಕ್ಕೇ Cformly. ಅಪ್ಲಿಕೇಶನ್ ಪಾಸ್‌ಪೋರ್ಟ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡುತ್ತದೆ (ನೀವು ಟೈಪ್ ಮಾಡಬೇಕಿಲ್ಲ), ಎಲ್ಲಾ ಫೀಲ್ಡ್‌ಗಳನ್ನು ಒಂದೇ ಪರದೆಯಲ್ಲಿ ಪರಿಶೀಲನೆಗೆ ತೋರಿಸುತ್ತದೆ ಹಾಗೂ ಪೋರ್ಟಲ್ ಫಾರ್ಮ್ ನಿಮಗಾಗಿ ಭರ್ತಿ ಮಾಡುತ್ತದೆ. ನಿಮ್ಮ ಕಾನೂನು ಜವಾಬ್ದಾರಿಗಳು ನಿಮ್ಮಲ್ಲೇ ಉಳಿಯುತ್ತವೆ — CAPTCHA ಪರಿಹರಿಸುವುದು ಮತ್ತು ಚಿತ್ರ ಲಗತ್ತಿಸುವುದು.",
      "faq.q1": "Cformly ಸರ್ಕಾರಿ ಅಪ್ಲಿಕೇಶನಾ?",
      "faq.a1":
        "ಇಲ್ಲ. Cformly ಒಂದು ಸ್ವತಂತ್ರ ಸಲ್ಲಿಕೆ ಸಹಾಯಕ. ನಿಖರ ಮತ್ತು ಸಕಾಲಿಕ ಸಲ್ಲಿಕೆಗೆ ಕಾನೂನು ಜವಾಬ್ದಾರಿ ಆತಿಥೇಯರದೇ; Cformly FRRO ಅಥವಾ ಭಾರತ ಸರ್ಕಾರದೊಂದಿಗೆ ಸಂಬಂಧ/ಅನುಮೋದನೆ ಹೊಂದಿಲ್ಲ.",
      "faq.q2": "ಪೋರ್ಟಲ್‌ನಲ್ಲಿ CAPTCHA ಯಾರು ಪರಿಹರಿಸುತ್ತಾರೆ?",
      "faq.a2":
        "ಯಾವಾಗಲೂ ಆತಿಥೇಯರು. ವಿಸ್ತರಣೆ ಫಾರ್ಮ್ ಫೀಲ್ಡ್‌ಗಳನ್ನು ಭರ್ತಿ ಮಾಡುತ್ತದೆ; ಸಲ್ಲಿಸುವ ಮೊದಲು ಮಾನವನೇ CAPTCHA ಪರಿಹರಿಸಿ ಚಿತ್ರ ಲಗತ್ತಿಸುತ್ತಾರೆ.",
      "faq.q3": "ಅತಿಥಿ ಡೇಟಾ ಎಲ್ಲಿ ಇರುತ್ತದೆ?",
      "faq.a3":
        "ಪಾಸ್‌ಪೋರ್ಟ್ ಮತ್ತು ವೀಸಾಗಳನ್ನು ಮುಕ್ತ-ಮೂಲ OCR ಮೂಲಕ ಫೋನ್‌ನಲ್ಲೇ ಓದಲಾಗುತ್ತದೆ — ಯಾವುದೇ ಮೂರನೇ-ಪಕ್ಷದ AI ಸೇವೆಗಳಿಲ್ಲ, ಯಾವುದೇ ದಸ್ತಾವೇಜಿನ ಚಿತ್ರ ಎಂದಿಗೂ ಅಪ್‌ಲೋಡ್ ಆಗುವುದಿಲ್ಲ. ಅತಿಥಿ ಡೇಟಾ ಸಾಧನದಲ್ಲಿ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿ ಸಂಗ್ರಹವಾಗಿದ್ದು, ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ಯಾವಾಗ ಬೇಕಾದರೂ ರಫ್ತು ಅಥವಾ ಅಳಿಸಬಹುದು.",
      "faq.q4": "ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಕೆಲಸ ಮಾಡುತ್ತದೆಯೇ?",
      "faq.a4":
        "ಸ್ಕ್ಯಾನಿಂಗ್, ಫೀಲ್ಡ್ ಹೊರತೆಗೆಯುವಿಕೆ, ದಾಖಲೆ ಪರಿಶೀಲನೆ ಮತ್ತು ಪೋರ್ಟಲ್ ಭರ್ತಿ ಎಲ್ಲವೂ ಸಾಧನದಲ್ಲೇ ಪೂರ್ಣವಾಗಿ ನಡೆಯುತ್ತವೆ — ಪಾಸ್‌ಪೋರ್ಟ್ ಓದಲು ಅಥವಾ ಫಾರ್ಮ್ ಭರ್ತಿಗೆ ಸಂಪರ್ಕ ಬೇಡ. FRRO ಪೋರ್ಟಲ್‌ಗೆ ಸಲ್ಲಿಕೆಗೆ ಬ್ರೌಸರ್ ಬೇಕು (ವಿಸ್ತರಣೆ ಇರಲಿ ಇಲ್ಲದಿರಲಿ).",
      "faq.q5": "24-ಗಂಟೆಗಳ ನಿಯಮ ಎಂದರೇನು?",
      "faq.a5":
        "ವಿದೇಶಿ ಅತಿಥಿಗಳನ್ನು ಚೆಕ್-ಇನ್ ಆದ 24 ಗಂಟೆಗಳ ಒಳಗೆ FRRO ಯಲ್ಲಿ ನೋಂದಾಯಿಸಬೇಕು. ಅತಿಥಿ ಕ್ಯಾಪ್ಚರ್ ಆದ ಕ್ಷಣದಿಂದ Cformly ಉಳಿದ ಸಮಯ ತೋರಿಸುತ್ತದೆ — ರಾತ್ರಿ ಶಿಫ್ಟ್‌ಗೆ ಗಡುವು ಗೊತ್ತಿಲ್ಲದೆ ಬಾರದು.",
      "faq.q6": "ಯಾವ ಭಾಷೆಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ?",
      "faq.a6": "ಹನ್ನೆರಡು: English, ಹಿನ್ದಿ, ಕನ್ನಡ, தமிழ், తెలుగు, മലയാളം, ਪੰਜਾਬੀ, मराठी, اردو, বাংলা, ગુજરાતી ಮತ್ತು অসমীয়া — ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ಬದಲಿಸಬಹುದು.",

      /* index — cta / disclaimer */
      "cta.title": "ಪಾಸ್‌ಪೋರ್ಟ್ ಮತ್ತೆ ಟೈಪ್ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿ. ವೇಗವಾಗಿ ಸಲ್ಲಿಸಲು ಪ್ರಾರಂಭಿಸಿ.",
      "cta.lede":
        "Cformly App Store ಮತ್ತು Google Play ನಲ್ಲಿ ಬರಲಿದೆ. ನಿಮ್ಮ ವಿಳಾಸ ಬಿಟ್ಟುಹೋಗಿ, ಬಿಡುಗಡೆಯಾದಾಗ ತಿಳಿಸುತ್ತೇವೆ.",
      "cta.primary": "ಸುಲಭ ಮಾರ್ಗದಿಂದ ಭರ್ತಿ ಪ್ರಾರಂಭಿಸಿ",
      "cta.appStore": "App Store",
      "cta.googlePlay": "Google Play",
      "cta.comingSoon": "ಶೀಘ್ರವೇ",
      "disclaimers.main":
        "Cformly ಒಂದು ಸಲ್ಲಿಕೆ ಸಹಾಯಕ. Immigration and Foreigners Act 2025 ಅಡಿಯಲ್ಲಿ ನಿಖರ ಮತ್ತು ಸಕಾಲಿಕ Form III ಸಲ್ಲಿಕೆಗೆ ಕಾನೂನು ಜವಾಬ್ದಾರಿ ಆತಿಥೇಯರದೇ. Cformly FRRO ಅಥವಾ ಭಾರತ ಸರ್ಕಾರದೊಂದಿಗೆ ಸಂಬಂಧ/ಅನುಮೋದನೆ ಹೊಂದಿಲ್ಲ.",

      /* index — meta */
      "meta.indexTitle": "Cformly — ಫ್ರಂಟ್ ಡೆಸ್ಕ್‌ನ 24-ಗಂಟೆಗಳ ನೋಂದಣಿ",
      "meta.indexDesc":
        "FRRO Form C ಅನ್ನು ಇಡೀ ಶಿಫ್ಟ್ ಅಲ್ಲ, ಕೆಲವೇ ನಿಮಿಷಗಳಲ್ಲಿ ಭರ್ತಿ ಮಾಡಿ. Cformly ಪಾಸ್‌ಪೋರ್ಟ್ ಸ್ಕ್ಯಾನ್ ಮಾಡುತ್ತದೆ, ಎಲ್ಲಾ ಫೀಲ್ಡ್‌ಗಳನ್ನು ಒಂದೇ ಪರದೆಯಲ್ಲಿ ತೋರಿಸುತ್ತದೆ ಹಾಗೂ FRRO ಪೋರ್ಟಲ್ ಫಾರ್ಮ್ ಸ್ವಯಂ-ಭರ್ತಿ ಮಾಡುತ್ತದೆ. ಅಪ್ಲಿಕೇಶನ್ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ — ಟೈಪಿಂಗ್ ಇಲ್ಲ, ತಪ್ಪಿಲ್ಲ, 24-ಗಂಟೆಗಳ ಗಡುವು ಭದ್ರ.",
      "meta.indexOgTitle": "Cformly — ಫ್ರಂಟ್ ಡೆಸ್ಕ್‌ನ 24-ಗಂಟೆಗಳ ನೋಂದಣಿ",
      "meta.indexOgDesc":
        "FRRO Form C ಅನ್ನು ಕೆಲವೇ ನಿಮಿಷಗಳಲ್ಲಿ ಭರ್ತಿ ಮಾಡಿ. Cformly ಪಾಸ್‌ಪೋರ್ಟ್ ಸ್ಕ್ಯಾನ್ ಮಾಡುತ್ತದೆ, ಪ್ರತಿ ಫೀಲ್ಡ್ ಪರಿಶೀಲಿಸುತ್ತದೆ ಹಾಗೂ ಪೋರ್ಟಲ್ ಫಾರ್ಮ್ ನಿಮಗಾಗಿ ಭರ್ತಿ ಮಾಡುತ್ತದೆ — ಟೈಪಿಂಗ್ ಇಲ್ಲ, ತಪ್ಪಿಲ್ಲ, ಗಡುವು ಭದ್ರ.",

      /* privacy page */
      "privacy.title": "ಗೋಪ್ಯತಾ ಸೂಚನೆ ಮತ್ತು ಒಪ್ಪಿಗೆ",
      "privacy.lede":
        "DPDP Act 2023 ಗೆ ಅನುಸಾರ. Cformly ಏನನ್ನು ಸಂಗ್ರಹಿಸುತ್ತದೆ, ಎಲ್ಲಿ ಸಂಗ್ರಹವಾಗುತ್ತದೆ, ಅದರ ಮೇಲೆ ನಿಮಗಿರುವ ಹಕ್ಕುಗಳೇನು ಎಂಬುದನ್ನು ಈ ಸೂಚನೆ ವಿವರಿಸುತ್ತದೆ.",
      "privacy.collect": "ನಾವು ಏನನ್ನು ಸಂಗ್ರಹಿಸುತ್ತೇವೆ",
      "privacy.collectIntro":
        "ನಿಮ್ಮ ಅತಿಥಿಗಳ ಪರವಾಗಿ Form C / Form III (ವಿದೇಶಿ ನೋಂದಣಿ) ಸಲ್ಲಿಸಲು ಬೇಕಾದ ಕನಿಷ್ಠ ಡೇಟಾವನ್ನು Cformly ಸಂಗ್ರಹಿಸುತ್ತದೆ:",
      "privacy.collect1":
        "<strong>ಅತಿಥಿ ಪಾಸ್‌ಪೋರ್ಟ್ ಡೇಟಾ:</strong> ಪೂರ್ಣ ಹೆಸರು, ಕುಟುಂಬನಾಮ, ವ್ಯಕ್ತಿನಾಮ, ಲಿಂಗ, ಜನ್ಮ ದಿನಾಂಕ, ರಾಷ್ಟ್ರೀಯತೆ, ಪಾಸ್‌ಪೋರ್ಟ್ ಸಂಖ್ಯೆ, ವಿತರಣಾ ಸ್ಥಳ/ದಿನಾಂಕ, ಅವಧಿ ಮುಕ್ತಾಯ. ಸಾಧನದಲ್ಲಿ ಮುಕ್ತ-ಮೂಲ OCR ಮೂಲಕ ಪಾಸ್‌ಪೋರ್ಟ್‌ನ MRZ ಸಾಲಿನಿಂದ ಓದಲಾಗುತ್ತದೆ — <strong>ಎಂದಿಗೂ ಸರ್ವರ್‌ಗೆ ಅಪ್‌ಲೋಡ್ ಆಗುವುದಿಲ್ಲ</strong>.",
      "privacy.collect2":
        "<strong>ಅತಿಥಿ ವೀಸಾ ಡೇಟಾ:</strong> ವೀಸಾ ಸಂಖ್ಯೆ, ವಿಧ, ವಿತರಣಾ ಸ್ಥಳ/ದಿನಾಂಕ, ಅವಧಿ ಮುಕ್ತಾಯ. ಅದೇ ಸಾಧನ-ಆಧಾರಿತ OCR ಮೂಲಕ ವೀಸಾದಿಂದ ಓದಲಾಗುತ್ತದೆ — <strong>ಎಂದಿಗೂ ಅಪ್‌ಲೋಡ್ ಆಗುವುದಿಲ್ಲ</strong>.",
      "privacy.collect3":
        "<strong>ಅತಿಥಿ ಚಿತ್ರ:</strong> ಕ್ಯಾಪ್ಚರ್ ಮಾಡಿ ಪೋರ್ಟಲ್ ಮಿತಿಗೆ ಅಳವಡಿಸಿ, ಸಾಧನದಲ್ಲಿ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿ ಸಂಗ್ರಹ.",
      "privacy.collect4":
        "<strong>ಆತಿಥೇಯ/ಆಸ್ತಿ ಪ್ರೊಫೈಲ್:</strong> ಸ್ಥಾಪನೆಯ ಹೆಸರು, ವಿಳಾಸ, FRRO ಕಚೇರಿ ವ್ಯಾಪ್ತಿ, ಸಂಪರ್ಕ ವಿವರ. ಒಮ್ಮೆ ನಮೂದಿಸಿ, ಎಲ್ಲಾ ಸಲ್ಲಿಕೆಗಳಲ್ಲಿ ಮರುಬಳಕೆ.",
      "privacy.whereStored": "ಡೇಟಾ ಎಲ್ಲಿ ಸಂಗ್ರಹವಾಗುತ್ತದೆ",
      "privacy.where1":
        "<strong>ಸಾಧನದ ಒಳಗಿನ ಎನ್‌ಕ್ರಿಪ್ಟ್ SQLite ಡೇಟಾಬೇಸ್</strong> (ಕೀ iOS Keychain / Android Keystore ನಲ್ಲಿ, ಲಭ್ಯವಿದ್ದಲ್ಲಿ ಹಾರ್ಡ್‌ವೇರ್ ಆಧಾರಿತ). ಎಂದಿಗೂ ಸ್ಪಷ್ಟಪಠ್ಯದಲ್ಲಿ ಇಲ್ಲ, ಎಂದಿಗೂ ಕ್ಲೌಡ್ ಬ್ಯಾಕಪ್‌ನಲ್ಲಿ ಇಲ್ಲ.",
      "privacy.where2":
        "<strong>ಬ್ಯಾಕ್‌ಎಂಡ್ (ಭಾರತ ಪ್ರದೇಶ):</strong> ಕೇವಲ ಆತಿಥೇಯ ಖಾತೆ ಮತ್ತು ದೃಢೀಕರಣ ಟೋಕನ್‌ಗಳು. <strong>ಯಾವುದೇ ದಸ್ತಾವೇಜು ಡೇಟಾ ಇಲ್ಲ, ಎಂದಿಗೂ</strong> — ಪಾಸ್‌ಪೋರ್ಟ್/ವೀಸಾ ಚಿತ್ರ ಅಥವಾ ಹೊರತೆಗೆದ ಫೀಲ್ಡ್‌ಗಳು ಸರ್ವರನ್ನು ತಾಕುವುದಿಲ್ಲ.",
      "privacy.howUsed": "ನಾವು ಇದನ್ನು ಹೇಗೆ ಬಳಸುತ್ತೇವೆ",
      "privacy.use1":
        "Form C / Form III ಫೀಲ್ಡ್‌ಗಳನ್ನು ಪರಿಶೀಲನೆ ಮತ್ತು ಸಲ್ಲಿಕೆಗಾಗಿ ಪೂರ್ವ-ಭರ್ತಿ ಮಾಡಲು.",
      "privacy.use2":
        "ಭರ್ತಿಸಿದ ಫೀಲ್ಡ್‌ಗಳನ್ನು ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಅಥವಾ PDF ಗೆ ನಕಲಿಸಿ, ಕೈಯಿಂದ ಪೋರ್ಟಲ್‌ಗೆ ಪೇಸ್ಟ್ ಮಾಡಲು.",
      "privacy.use3":
        "ಉಚಿತ ಬ್ರೌಸರ್ ವಿಸ್ತರಣೆಯ ಮೂಲಕ FRRO ಪೋರ್ಟಲ್ ಫಾರ್ಮ್ ಸ್ವಯಂ-ಭರ್ತಿ ಮಾಡಲು (ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಆತಿಥೇಯರೇ ಇರುತ್ತಾರೆ; ಸರ್ವರ್ ರಿಲೇ ಇಲ್ಲ).",
      "privacy.rights": "ನಿಮ್ಮ ಹಕ್ಕುಗಳು (DPDP Act 2023)",
      "privacy.right1":
        "<strong>ಪ್ರವೇಶ:</strong> ನಿಮ್ಮ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಯಂತ್ರ-ಓದುವ JSON ರೂಪದಲ್ಲಿ ರಫ್ತು ಮಾಡಿ (Settings &gt; Data &amp; Privacy &gt; Export Data).",
      "privacy.right2":
        "<strong>ತಿದ್ದುಪಡಿ:</strong> ಸಲ್ಲಿಸುವ ಮೊದಲು ಪರಿಶೀಲನಾ ಪರದೆಯಲ್ಲಿ ಯಾವುದೇ ಅತಿಥಿ ಫೀಲ್ಡ್ ಸರಿಪಡಿಸಬಹುದು.",
      "privacy.right3":
        "<strong>ಅಳಿಸುವಿಕೆ:</strong> Settings &gt; Delete Account ಎಲ್ಲಾ ಸ್ಥಳೀಯ PII ಮತ್ತು ಕೀಗಳನ್ನು ತೆಗೆದು ಸರ್ವರ್-ಪಾರ್ಶ್ವ ಅಳಿಸುವಿಕೆ ಪ್ರಾರಂಭಿಸುತ್ತದೆ. ಪೂರ್ಣವಾದಾಗ ದೃಢೀಕರಣ ಸಿಗುತ್ತದೆ.",
      "privacy.right4":
        '<strong>ದೂರು:</strong> ಯಾವುದೇ ಗೋಪ್ಯತಾ ಆಸಕ್ತಿ ಅಥವಾ ಡೇಟಾ ವಿನಂತಿಗೆ <a href="mailto:dpo@cformly.com">dpo@cformly.com</a> ಗೆ ಸಂಪರ್ಕಿಸಿ.',
      "privacy.retention": "ಡೇಟಾ ಉಳಿಸಿಕೆ",
      "privacy.retention1":
        "ದಸ್ತಾವೇಜಿನ ಚಿತ್ರಗಳು ಮತ್ತು ಹೊರತೆಗೆದ ಫೀಲ್ಡ್‌ಗಳು ನೀವು ಅಳಿಸುವವರೆಗೆ ಸಾಧನದಲ್ಲೇ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿ ಇರುತ್ತವೆ. ಅವು ಸಾಧನವನ್ನು ಬಿಡುವುದು ನಿಮ್ಮ ಸ್ಪಷ್ಟ ಕ್ರಿಯೆಯ ಮೂಲಕ ಮಾತ್ರ — ಪರಿಶೀಲಿಸಿದ ಫೀಲ್ಡ್‌ಗಳನ್ನು FRRO ಪೋರ್ಟಲ್‌ಗೆ ಕಳುಹಿಸುವಾಗ ಅಥವಾ ಪ್ರತಿ ರಫ್ತು ಮಾಡುವಾಗ — Cformly ಸರ್ವರ್‌ಗೆ ಎಂದಿಗೂ ಇಲ್ಲ.",
      "privacy.retention2":
        "ಎನ್‌ಕ್ರಿಪ್ಟ್ ಸ್ಥಳೀಯ ಸಂಗ್ರಹ ನೀವು ಖಾತೆ ಅಳಿಸುವ ಅಥವಾ ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವವರೆಗೆ ಇರುತ್ತದೆ.",
      "privacy.crossBorder": "ಗಡಿ-ಪ್ರಕ್ರಿಯೆ",
      "privacy.crossBorderBody":
        "ಎಲ್ಲಾ ದಸ್ತಾವೇಜು ಕ್ಯಾಪ್ಚರ್ ಮತ್ತು OCR ಸಂಪೂರ್ಣವಾಗಿ ಫೋನ್‌ನಲ್ಲೇ ನಡೆಯುತ್ತದೆ. ಅತಿಥಿಗಳ ಪಾಸ್‌ಪೋರ್ಟ್, ವೀಸಾ ಮತ್ತು ಫೀಲ್ಡ್ ಡೇಟಾ Cformly ಸರ್ವರ್‌ಗೆ ಎಂದಿಗೂ ಕಳುಹಿಸಲ್ಪಡುವುದಿಲ್ಲ ಮತ್ತು ನಮ್ಮ ಮೂಲಕ ಗಡಿ ದಾಟುವುದಿಲ್ಲ; ನೀವೇ ಫೀಲ್ಡ್‌ಗಳನ್ನು ಅಧಿಕೃತ FRRO ಪೋರ್ಟಲ್‌ಗೆ ಕಳುಹಿಸಿದಾಗ ಅಥವಾ ಪ್ರತಿ ರಫ್ತು ಮಾಡಿದಾಗ ಮಾತ್ರ ಅದು ಸಾಧನವನ್ನು ಬಿಡುತ್ತದೆ. ಕೇವಲ ಆತಿಥೇಯ ಖಾತೆಗಳು ಮತ್ತು ಪ್ರಾಪರ್ಟಿ ಡೇಟಾ (ಅತಿಥಿಯೇತರ) ಭಾರತ ಪ್ರದೇಶದಲ್ಲಿ ಇರಿಸಲ್ಪಡುತ್ತವೆ.",
      "privacy.consent": "ಒಪ್ಪಿಗೆ",
      "privacy.consentBody":
        "Cformly ಬಳಸುವ ಮೂಲಕ ಈ ಡೇಟಾ ಪ್ರಕ್ರಿಯೆಗೆ ನೀವು ಸಮ್ಮತಿಸುತ್ತೀರಿ. ಖಾತೆ ಅಳಿಸುವ ಮೂಲಕ ಯಾವಾಗ ಬೇಕಾದರೂ ಒಪ್ಪಿಗೆ ಹಿಂತೆಗೆದುಕೊಳ್ಳಬಹುದು. ಈಗಾಗಲೇ FRRO ಗೆ ಸಲ್ಲಿಸಿದ ಅರ್ಜಿಗಳ ಮೇಲೆ ಹಿಂತೆಗೆದುಕೊಳ್ಳುವಿಕೆ ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ (ಅವು FRRO ಯ ನಿಯಮಗಳಿಗೆ ಒಳಪಡುತ್ತವೆ).",
      "privacy.contactH": "ಸಂಪರ್ಕ",
      "privacy.dpoLabel": "ಡೇಟಾ ಸಂರಕ್ಷಣಾ ಅಧಿಕಾರಿ:",
      "privacy.securityLabel": "ಭದ್ರತೆ:",
      "privacy.supportLabel": "ಬೆಂಬಲ:",
      "meta.privacyTitle": "ಗೋಪ್ಯತಾ ನೀತಿ — Cformly",
      "meta.privacyDesc":
        "Cformly ಗೋಪ್ಯತಾ ಸೂಚನೆ ಮತ್ತು ಒಪ್ಪಿಗೆ — DPDP Act 2023 ಗೆ ಅನುಸಾರ. ನಾವು ಏನು ಸಂಗ್ರಹಿಸುತ್ತೇವೆ, ಡೇಟಾ ಎಲ್ಲಿ ಸಂಗ್ರಹವಾಗುತ್ತದೆ, ನಿಮ್ಮ ಹಕ್ಕುಗಳು.",

      /* terms page */
      "terms.title": "ಸೇವಾ ನಿಯಮಗಳು",
      "terms.lede":
        "ಅಪ್ಲಿಕೇಶನ್, ವಿಸ್ತರಣೆ ಮತ್ತು ಈ ವೆಬ್‌ಸೈಟ್ ಬಳಕೆಗೆ ನಿಮ್ಮ ಮತ್ತು Cformly ನಡುವಿನ ಒಪ್ಪಂದ.",
      "terms.acceptance": "1. ನಿಯಮಗಳ ಒಪ್ಪಿಗೆ",
      "terms.acceptanceBody":
        'Cformly ಮೊಬೈಲ್ ಅಪ್ಲಿಕೇಶನ್ ("ಅಪ್ಲಿಕೇಶನ್") ಅನ್ನು ಡೌನ್‌ಲೋಡ್, ಇನ್‌ಸ್ಟಾಲ್ ಅಥವಾ ಬಳಸುವ ಮೂಲಕ, ಈ ಸೇವಾ ನಿಯಮಗಳಿಗೆ ("ನಿಯಮಗಳು") ನೀವು ಒಳಪಡಲು ಒಪ್ಪುತ್ತೀರಿ. ಒಪ್ಪದಿದ್ದರೆ ಅಪ್ಲಿಕೇಶನ್ ಬಳಸಬೇಡಿ.',
      "terms.description": "2. ಸೇವೆಯ ವಿವರಣೆ",
      "terms.descriptionBody":
        'Cformly ಒಂದು ಸಲ್ಲಿಕೆ ಸಹಾಯಕ; ಹೋಟೆಲ್, ಗೆಸ್ಟ್ ಹೌಸ್ ಮತ್ತು ವೈಯಕ್ತಿಕ ಆತಿಥೇಯರು ("ಆತಿಥೇಯರು") Immigration and Foreigners Act, 2025 ಮತ್ತು ಸಂಬಂಧಿತ ನಿಯಮಗಳ ಅಡಿಯಲ್ಲಿ ಬೇಕಾದ FRRO Form C (ವಿದೇಶಿ ನೋಂದಣಿ / Form III) ಸಿದ್ಧಪಡಿಸಲು ಮತ್ತು ಸಲ್ಲಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ.',
      "terms.disclaimer": "3. ಪ್ರಮುಖ ವಿವರಣೆ",
      "terms.disclaimerBold":
        "<strong>Cformly FRRO (Foreigners Regional Registration Office), Bureau of Immigration ಅಥವಾ ಭಾರತ ಸರ್ಕಾರದೊಂದಿಗೆ ಸಂಬಂಧ, ಅನುಮೋದನೆ ಅಥವಾ ಸಂಪರ್ಕ ಹೊಂದಿಲ್ಲ.</strong>",
      "terms.disclaimerBody":
        "Cformly ಒಂದು ಸ್ವತಂತ್ರ ಸಲ್ಲಿಕೆ ಸಹಾಯಕ. ಸಲ್ಲಿಸಲಾದ ಎಲ್ಲಾ ಮಾಹಿತಿಯ ನಿಖರತೆ, ನಿಗದಿತ ಅವಧಿಯ ಒಳಗಿನ ಸಕಾಲಿಕ ಸಲ್ಲಿಕೆ ಮತ್ತು ಎಲ್ಲಾ ಅನ್ವಯ ಕಾನೂನುಗಳ ಪಾಲನೆಗೆ ಏಕೈಕ ಕಾನೂನು ಜವಾಬ್ದಾರಿ ಆತಿಥೇಯರದೇ.",
      "terms.obligations": "4. ಆತಿಥೇಯರ ಜವಾಬ್ದಾರಿಗಳು",
      "terms.obligation1": "ನಿಖರವಾದ ಆಸ್ತಿ ನೋಂದಣಿ ವಿವರ ಒದಗಿಸಿ",
      "terms.obligation2":
        "ಸಲ್ಲಿಸುವ ಮೊದಲು ಹೊರತೆಗೆದ ಎಲ್ಲಾ ಡೇಟಾ ಪರಿಶೀಲಿಸಿ (OCR ನಲ್ಲಿ ತಪ್ಪು ಆಗಬಹುದು)",
      "terms.obligation3":
        "ಅತಿಥಿಯು ತಮ್ಮ ಡೇಟಾ ಸಂಗ್ರಹಕ್ಕೆ ಒಪ್ಪಿರುವುದನ್ನು ಖಚಿತಪಡಿಸಿ",
      "terms.obligation4": "ಕಾನೂನು ನಿಗದಿತ ಅವಧಿಯ ಒಳಗೆ Form C ಸಲ್ಲಿಸಿ",
      "terms.obligation5":
        "ಸುಳ್ಳು, ಮೋಸದ ಅಥವಾ ಗೊಂದಲ ಸೃಷ್ಟಿಸುವ ಮಾಹಿತಿ ಸಲ್ಲಿಸಲು ಅಪ್ಲಿಕೇಶನ್ ಬಳಸಬೇಡಿ",
      "terms.privacy": "5. ಗೋಪ್ಯತೆ ಮತ್ತು ಡೇಟಾ ನಿರ್ವಹಣೆ",
      "terms.privacyBody":
        'ಅಪ್ಲಿಕೇಶನ್ ಬಳಕೆಯ ಮೇಲೆ ನಮ್ಮ <a href="privacy.html">ಗೋಪ್ಯತಾ ನೀತಿ</a> ಕೂಡ ಅನ್ವಯವಾಗುತ್ತದೆ. ಎಲ್ಲಾ ಅತಿಥಿ ಡೇಟಾ SQLCipher (AES-256) ಬಳಸಿ ಸಾಧನದಲ್ಲಿ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿ ಸಂಗ್ರಹವಾಗುತ್ತದೆ; ದಸ್ತಾವೇಜು ಕ್ಯಾಪ್ಚರ್ ಮತ್ತು OCR ಸಂಪೂರ್ಣವಾಗಿ ಸಾಧನದಲ್ಲೇ ನಡೆಯುತ್ತದೆ. ಬ್ಯಾಕ್‌ಎಂಡ್ ಕೇವಲ ಆತಿಥೇಯ ಖಾತೆಗಳನ್ನು (PII ಇಲ್ಲದ) ಭಾರತದಲ್ಲಿ ಇಟ್ಟುಕೊಳ್ಳುತ್ತದೆ. ಯಾವುದೇ ಮೂರನೇ-ಪಕ್ಷದ AI ಸೇವೆ ಬಳಕೆಯಾಗುವುದಿಲ್ಲ.',
      "terms.accuracy": "6. ಡೇಟಾ ನಿಖರತೆ",
      "terms.accuracyBody":
        "ಪಾಸ್‌ಪೋರ್ಟ್ ಮತ್ತು ವೀಸಾಗಳಿಂದ ಡೇಟಾ ಹೊರತೆಗೆಯಲು ಅಪ್ಲಿಕೇಶನ್ OCR ಬಳಸುತ್ತದೆ. OCR 100% ನಿಖರವಲ್ಲ. ಸಲ್ಲಿಸುವ ಮೊದಲು ಆತಿಥೇಯರು ಹೊರತೆಗೆದ ಎಲ್ಲಾ ಡೇಟಾ ಪರಿಶೀಲಿಸಬೇಕು.",
      "terms.liability": "7. ಜವಾಬ್ದಾರಿ ಮಿತಿ",
      "terms.liabilityBody":
        'ಕಾನೂನು ಅನುಮತಿಸುವ ಗರಿಷ್ಠ ಮಟ್ಟದವರೆಗೆ, Cformly ಯಾವುದೇ ಖಾತರಿ ಇಲ್ಲದೆ "AS IS" ರೀತಿಯಲ್ಲಿ ಒದಗಿಸಲಾಗಿದೆ. ತಡವಾದ, ತಪ್ಪಾದ ಅಥವಾ ಅಪೂರ್ಣ Form C ಸಲ್ಲಿಕೆಗಳಿಂದ ಉದ್ಭವಿಸುವ ದಂಡ, ದಂಡಾತ್ಮಕ ಪರಿಣಾಮ ಅಥವಾ ಕಾನೂನು ಪರಿಣಾಮಗಳಿಗೆ ನಾವು ಜವಾಬ್ದಾರರಲ್ಲ.',
      "terms.contactH": "8. ಸಂಪರ್ಕ",
      "terms.grievanceLabel": "ಗೋಪ್ಯತೆ/ದೂರು:",
      "terms.governing": "9. ಆಡಳಿತ ಕಾನೂನು",
      "terms.governingBody":
        "ಈ ನಿಯಮಗಳು ಭಾರತದ ಕಾನೂನುಗಳಿಗೆ ಒಳಪಡುತ್ತವೆ. ಯಾವುದೇ ವಿವಾದ ಭಾರತದ ಮಹಾರಾಷ್ಟ್ರದ ಮುಂಬೈ ನ್ಯಾಯಾಲಯಗಳ ವಿಶಿಷ್ಟ ವ್ಯಾಪ್ತಿಗೆ ಒಳಪಡುತ್ತದೆ.",
      "meta.termsTitle": "ಸೇವಾ ನಿಯಮಗಳು — Cformly",
      "meta.termsDesc":
        "Cformly ಸೇವಾ ನಿಯಮಗಳು — ಒಪ್ಪಿಗೆ, ಆತಿಥೇಯರ ಜವಾಬ್ದಾರಿಗಳು, ಡೇಟಾ ನಿಖರತೆ, ಜವಾಬ್ದಾರಿ ಮಿತಿ, ಆಡಳಿತ ಕಾನೂನು.",
    };
