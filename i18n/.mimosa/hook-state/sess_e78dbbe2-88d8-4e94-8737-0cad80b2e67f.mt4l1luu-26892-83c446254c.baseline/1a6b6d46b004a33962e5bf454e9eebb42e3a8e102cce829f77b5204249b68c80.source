window.CFORMLY_I18N["ta"] = {
      /* nav / global */
      "nav.how": "இது எப்படி வேலை செய்கிறது",
      "nav.privacy": "தனியுரிமை",
      "nav.faq": "அடிக்கடி கேட்கப்படும் கேள்விகள்",
      "nav.cta": "எளிய வழியில் நிரப்பத் தொடங்குங்கள்",
      "nav.ariaPrimary": "முதன்மை",
      "brand.aria": "Cformly முகப்பு",
      "lang.toggleAria": "மொழியை மாற்று",
      "legal.updated": "கடைசியாக புதுப்பிக்கப்பட்டது: ஆகஸ்ட் 2026",
      "back.toHome": "Cformly க்குத் திரும்பு",
      "footer.product": "தயாரிப்பு",
      "footer.legal": "Legal (தமிழ்)",
      "footer.contact": "தொடர்பு",
      "footer.privacy": "தனியுரிமைக் கொள்கை",
      "footer.terms": "சேவை விதிமுறைகள்",
      "footer.blurb":
        "இந்தியாவில் உள்ள ஹோட்டல் முன் மேசைகளுக்கான 24 மணி நேர பதிவேடு. ஸ்கேன் செய்யுங்கள், மதிப்பாய்வு செய்யுங்கள், அனுப்புங்கள் — சாதனத்தில், தனியாக.",
      "footer.copyright": "© 2026 Cformly. அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.",
      "footer.notAffiliated": "FRRO அல்லது இந்திய அரசுடன் எந்தத் தொடர்பும் இல்லை.",

      /* index — hero */
      "hero.eyebrow": "FRRO Form C · உங்கள் தொலைபேசியிலிருந்து நிரப்பப்பட்டது",
      "hero.title": "<em>FRRO Form C</em> ஐ நிரப்ப மிக விரைவான வழி.",
      "hero.lede":
        "ஒவ்வொரு வெளிநாட்டு விருந்தினரும் 24 மணி நேரத்திற்குள் FRRO இல் பதிவு செய்யப்பட வேண்டும். Cformly பாஸ்போர்ட்டை ஸ்கேன் செய்கிறது, ஒவ்வொரு புலத்தையும் சரிபார்க்கிறது, மற்றும் போர்ட்டல் படிவத்தை உங்களுக்காக நிரப்புகிறது — எனவே முழு தாக்கலும் நிமிடங்களில் முடியும். நீங்கள் உறுதிப்படுத்தி, ஒரு முறை CAPTCHA ஐ தீர்த்து, புகைப்படத்தை இணைக்க வேண்டும்.",
      "hero.ctaPrimary": "எளிய வழியில் நிரப்பத் தொடங்குங்கள்",
      "hero.secondaryCta": "நேரடியாகப் போர்ட்டலையே ஏன் பயன்படுத்தக்கூடாது?",
      "hero.ruleText": "ஒவ்வொரு விருந்தினருக்கும் Cformly கணக்கிடும் 24 மணி நேர கால அவகாசம்",

      /* index — why not the portal */
      "why.eyebrow": "நேர்மையான கேள்வி",
      "why.title": "போர்ட்டலில் Form C ஐ நேரடியாக ஏன் நிரப்பக்கூடாது?",
      "why.lede":
        "நீங்கள் சட்டப்பூர்வமாக செய்யலாம். போர்ட்டல் மெதுவானது, சிக்கலானது மற்றும் மன்னிக்காதது — பரபரப்பான இரவில் நீங்கள் செய்யும் தவறுகளுக்கு தண்டிக்கிறது. Cformly உங்களிடமிருந்து என்ன எடுக்கிறது என்பது இங்கே.",
      "why.item1Title": "பாஸ்போர்ட் எண்களை தட்டச்சு செய்ய வேண்டியதில்லை",
      "why.item1Body": "ஒரு பாஸ்போர்ட்டில் 40+ எழுத்துகள் கொண்ட இயந்திர-வாசிப்பு தரவு உள்ளது. Cformly அதை நேரடியாக கேமராவிலிருந்து படிக்கிறது — ஒரு விசை கூட அழுத்தாமல் ஒவ்வொரு பெயர், எண், தேதியும் நிரப்பப்படுகிறது; FRRO ஆய்வுக்கு காரணமாகும் தட்டச்சுத் தவறுகளும் இல்லை.",
      "why.item2Title": "ஒவ்வொரு புலமும் ஒரே திரையில்",
      "why.item2Body": "போர்ட்டல் படிவத்தை பல தாவல்கள் மற்றும் பக்கங்களாகப் பிரிக்கிறது. Cformly முழு பதிவையும் நம்பகத்தன்மை குறியீடுகளுடன் ஒரே மதிப்பாய்வுத் திரையில் காட்டுகிறது — எதுவும் தவறாது, எதுவும் ஊகிக்கப்படாது.",
      "why.item3Title": "போர்ட்டல் படிவம் தானே நிரம்புகிறது",
      "why.item3Body": "எக்ஸ்டென்ஷன் இல்லையா? புலங்களை ஒருமுறை நகலெடுங்கள். இலவச உலாவி எக்ஸ்டென்ஷன் மூலம் Cformly அந்தப் புலங்களிலிருந்து FRRO போர்ட்டல் படிவத்தை தானாக நிரப்புகிறது. கட்டுப்பாடு உங்களிடமே — CAPTCHA தீர்ப்பதும் புகைப்படம் இணைப்பதும் கட்டாயமாக உங்களுடையதே.",
      "why.item4Title": "24 மணி நேர காலக்கெடு எப்போதும் தெரியும்",
      "why.item4Body": "விருந்தினரைப் பதிவு செய்த தருணத்திலிருந்து Cformly எண்ணிக்கையைக் காட்டுகிறது. மனதில் சுமந்திருந்தது இப்போது திரையில் — இரவு ஷிப்ட் ஒருபோதும் தாமதமாகத் தாக்கல் செய்யாது, அபராதம் செலுத்தாது.",

      /* index — how it works */
      "how.eyebrow": "உங்கள் ஷிப்ட், எளிமைப்படுத்தப்பட்டது",
      "how.title": "மூன்று அடிகளில் விருந்தினரை செக்-இன் செய்யுங்கள்.",
      "how.lede": "தட்டச்சு இல்லை, போர்ட்டல் தாவல்களில் தேடுவது இல்லை. கவுண்டரிலிருந்து தாக்கல் செய்யப்பட்ட படிவம் வரை — ஒவ்வொரு விருந்தினருக்கும், ஒவ்வொரு முறையும் அதே மூன்று படிகள்.",
      "how.step1Title": "ஸ்கேன்",
      "how.step1Body": "பாஸ்போர்ட் மற்றும் விசாவை நோக்கி கேமராவைச் சுட்டுங்கள். OCR புலங்களை உடனே படிக்கிறது — தட்டச்சு இல்லை, தவறு இல்லை.",
      "how.step2Title": "சரிபார்",
      "how.step2Body": "ஒவ்வொரு புலமும் ஒரே திரையில்; OCR ஐயப்படும் எதற்கும் நம்பகத்தன்மைக் குறி. திருத்தி, வருகை மற்றும் தங்கும் விவரங்களைச் சேர்த்து, விருந்தினர் புகைப்படம் எடுங்கள்.",
      "how.step3Title": "தாக்கல்",
      "how.step3Body": "உலாவியில் போர்ட்டலைத் திறந்து நகலெடுத்த புலங்களை ஒட்டுங்கள் — எக்ஸ்டென்ஷன் படிவத்தை நிரப்பும். CAPTCHA தீர்த்து புகைப்படம் இணைத்தால் நிமிடங்களில் முடிந்தது.",

      /* index — privacy band */
      "privacy.pitch.title": "விருந்தினர் தரவு அந்தக் கட்டிடத்திலேயே இருக்கும்.",
      "privacy.pitch.lede": "பாஸ்போர்ட், விசா ஆகியவை தனிப்பட்ட தரவு. Cformly அவற்றை ஃபோனிலேயே படிக்கிறது — எனவே அந்தத் தரவு முன் மேசையை விட்டு வெளியேற வேண்டியதில்லை, Cformly சர்வரைத் தொடவுமே தொடாது.",
      "privacy.item1Title": "திறந்த மூல OCR, சாதனத்திலேயே",
      "privacy.item1Body": "பாஸ்போர்ட், விசா ஆகியவற்றை ஃபோனில் உள்ள திறந்த மூல மென்பொருளே படிக்கிறது — மூன்றாம் தரப்பு AI சேவைகள் இல்லை; ஆவணப் புகைப்படம் எந்தச் சர்வரிலும் பதிவேறுவதே இல்லை.",
      "privacy.item2Title": "ஃபோனில் மறையாக்கம்",
      "privacy.item2Body": "சாதனத்தில் SQLCipher, விசை ஹார்டுவேர் கீஸ்டோரில். பயோமெட்ரிக் அல்லது PIN பூட்டு, திரை தனியுரிமை, கிளிப்போர்டு சுகாதாரம் — அனைத்தும் உள்ளேயே உள்ளன.",
      "privacy.item3Title": "மனிதர் கட்டுப்பாட்டில்",
      "privacy.item3Body": "CAPTCHA மற்றும் புகைப்பட இணைப்பு ஹோஸ்ட்டிடமே இருக்கும். Cformly படிவத்தை நிரப்பும்; ஹோஸ்ட் தாக்கல் செய்வார்.",
      "privacy.item4Title": "உங்கள் தரவு, உங்கள் உரிமை",
      "privacy.item4Body": "அமைப்புகளிலிருந்து எப்போது வேண்டுமானாலும் அனைத்தையும் ஏற்றுமதி செய்யலாம் அல்லது நீக்கலாம் — DPDP சட்டம் 2023-ன் கீழ் உங்கள் உரிமைகள்.",

      /* index — languages */
      "lang.eyebrow": "மொழிகள்",
      "lang.title": "பன்னிரண்டு இந்திய மொழிகள், பக்கத்திற்கு பக்கம்.",
      "lang.lede":
        "இந்தியா முழுவதும் உள்ள முன் மேசைகள் பல மொழிகளைப் பேசுகின்றன. Cformly ம் அவ்வாறே, ஒவ்வொரு திரையிலும்.",
      "lang.enTitle": "English",
      "lang.hiTitle": "हिन्दी",
      "lang.sampleScan": "பாஸ்போர்ட் ஸ்கேன்",
      "lang.sampleReview": "விவரங்களை மதிப்பாய்வு",
      "lang.sampleSend": "போர்ட்டலுக்கு அனுப்பு",
      "lang.note":
        "அமைப்புகளிலிருந்து எப்போது வேண்டுமானாலும் மொழிகளை மாற்றவும் — ஒவ்வொரு திரையிலும்.",

      /* index — faq */
      "faq.eyebrow": "அடிக்கடி கேட்கப்படும் கேள்விகள்",
      "faq.title": "கேள்விகளுக்கு எளிய பதில்கள்.",
      "faq.q0": "FRRO இணையதளத்திலேயே படிவத்தை நிரப்ப முடியும்னா இந்த ஆப் ஏன் தேவை?",
      "faq.a0": "முடியும் — இரண்டையும் FRRO ஏற்க வேண்டுமே. ஆனால் போர்ட்டல் மெதுவானது, மன்னிக்காதது: கடினமான 24 மணி நேர காலக்கெடுவின் கீழ், தாவல்களில் சிதறிய டசன் கணக்கில் புலங்களைத் தட்டச்சு செய்ய வேண்டும். கைமுறை வழி நேரத்தை வீணாக்குவதாலும் தட்டச்சுத் தவறுகளை அழைத்துவர்வதாலுமே Cformly உள்ளது. ஆப் பாஸ்போர்ட்டை ஸ்கேன் செய்வதால் நீங்கள் அதைத் தட்டச்சு செய்யவே தேவையில்லை; ஒவ்வொரு புலமும் ஒரே திரையில் மதிப்பாய்வுக்கு வருகிறது; போர்ட்டல் படிவத்தையும் உங்களுக்காக நிரப்புகிறது. உங்களுடைய சட்டப் பொறுப்புகள் — CAPTCHA தீர்த்தல், புகைப்படம் இணைத்தல் — உங்களிடமே இருக்கின்றன.",
      "faq.q1": "Cformly அரசு ஆப்பா?",
      "faq.a1": "இல்லை. Cformly ஒரு சுதந்திரமான தாக்கல் உதவியாளர். துல்லியமாகவும் காலக்கெடுவிற்குள்ளும் தாக்கல் செய்யும் சட்டப் பொறுப்பு ஹோஸ்ட்டிடமே உள்ளது; FRRO அல்லது இந்திய அரசோடு Cformly-க்கு எந்தத் தொடர்பும் அங்கீகாரமும் இல்லை.",
      "faq.q2": "போர்ட்டலில் CAPTCHA யார் தீர்ப்பார்கள்?",
      "faq.a2": "எப்போதும் ஹோஸ்ட்தான். எக்ஸ்டென்ஷன் படிவப் புலங்களை மட்டும் நிரப்புகிறது; சமர்ப்பிக்கும் முன் மனிதர் CAPTCHA தீர்த்து புகைப்படம் இணைக்கிறார்.",
      "faq.q3": "விருந்தினர் தரவு எங்கு இருக்கிறது?",
      "faq.a3": "பாஸ்போர்ட், விசா ஆகியவற்றை ஃபோனிலேயே திறந்த மூல OCR மூலம் படிக்கிறோம் — மூன்றாம் தரப்பு AI இல்லை; ஆவணப் புகைப்படம் எங்கும் பதிவேறுவதில்லை. விருந்தினர் தரவு சாதனத்தில் மறையாக்கப்பட்டு சேமிக்கப்படுகிறது; அமைப்புகளிலிருந்து எப்போது வேண்டுமானாலும் ஏற்றுமதி அல்லது நீக்கம் செய்யலாம்.",
      "faq.q4": "ஆஃப்லைனில் வேலை செய்யுமா?",
      "faq.a4": "ஸ்கேன், புலப் பிரித்தெடுப்பு, பதிவு மதிப்பாய்வு, போர்ட்டல் நிரப்புதல் — அனைத்தும் முழுக்க சாதனத்திலேயே; பாஸ்போர்ட்டைப் படிக்கவோ படிவம் நிரப்பவோ இணைப்பு தேவையில்லை. FRRO போர்ட்டலில் தாக்கல் செய்ய உலாவி மட்டும் தேவை (எக்ஸ்டென்ஷன் இருந்தோ இல்லாயோ).",
      "faq.q5": "24 மணி நேர விதி என்ன?",
      "faq.a5": "வெளிநாட்டு விருந்தினர் செக்-இன் ஆன 24 மணி நேரத்திற்குள் FRRO-வில் பதிவு செய்யப்பட வேண்டும். விருந்தினரைப் பதிவு செய்த தருணத்திலிருந்து Cformly எண்ணிக்கையைக் காட்டுவதால், இரவு ஷிப்ட்டுக்கு காலக்கெடு திடீரென வராது.",
      "faq.q6": "இது எந்த மொழிகளை ஆதரிக்கிறது?",
      "faq.a6": "பன்னிரண்டு: ஆங்கிலம், இந்தி, கன்னடம், தமிழ், தெலுங்கு, மலையாளம், பஞ்சாபி, மராத்தி, உருது, வங்காளம், குஜராத்தி மற்றும் அசாமி — அமைப்புகளிலிருந்து மாற்றலாம்.",

      /* index — cta / disclaimer */
      "cta.title": "பாஸ்போர்ட்களை மீண்டும் தட்டச்சு செய்வதை நிறுத்துங்கள். விரைவாக தாக்கல் செய்யத் தொடங்குங்கள்.",
      "cta.lede": "Cformly விரைவில் App Store மற்றும் Google Play-இல் வருகிறது. உங்கள் முகவரியை விட்டுவிடுங்கள் — வெளியானதும் தெரிவிப்போம்.",
      "cta.primary": "எளிய வழியில் நிரப்பத் தொடங்குங்கள்",
      "cta.appStore": "App Store",
      "cta.googlePlay": "Google Play",
      "cta.comingSoon": "விரைவில் வருகிறது",
      "disclaimers.main": "Cformly ஒரு தாக்கல் உதவியாளர். Immigration and Foreigners Act 2025-ன் கீழ் Form III-ஐ துல்லியமாகவும் காலக்கெடுவிற்குள்ளும் தாக்கல் செய்யும் சட்டப் பொறுப்பு ஹோஸ்ட்டிடமே உள்ளது. FRRO அல்லது இந்திய அரசோடு Cformly-க்கு தொடர்போ அங்கீகாரமோ இல்லை.",

      /* index — meta */
      "meta.indexTitle": "Cformly — முன் மேசையின் 24 மணி நேரப் பதிவேடு",
      "meta.indexDesc": "FRRO Form C-ஐ ஒரு ஷிப்ட் முழுதும் அல்ல, நிமிடங்களில் நிரப்புங்கள். Cformly பாஸ்போர்ட்டை ஸ்கேன் செய்கிறது, ஒவ்வொரு புலத்தையும் ஒரே திரையில் காட்டுகிறது, FRRO போர்ட்டல் படிவத்தை தானாக நிரப்புகிறது. ஆப்பைப் பதிவிறக்குங்கள் — தட்டச்சு இல்லை, தவறு இல்லை, 24 மணி நேர காலக்கெடு மூடப்பட்டது.",
      "meta.indexOgTitle": "Cformly — முன் மேசையின் 24 மணி நேரப் பதிவேடு",
      "meta.indexOgDesc": "FRRO Form C-ஐ நிமிடங்களில் நிரப்புங்கள். Cformly பாஸ்போர்ட்டை ஸ்கேன் செய்கிறது, ஒவ்வொரு புலத்தையும் மதிப்பாய்வு செய்கிறது, போர்ட்டல் படிவத்தை உங்களுக்காக நிரப்புகிறது — தட்டச்சு இல்லை, தவறு இல்லை.",

      /* privacy page */
      "privacy.title": "தனியுரிமை அறிவிப்பு மற்றும் ஒப்புதல்",
      "privacy.lede":
        "DPDP சட்டம் 2023 க்கு இணங்க. Cformly என்ன சேகரிக்கிறது, எங்கு சேமிக்கப்படுகிறது, மற்றும் அதன் மீது உங்களுக்கு உள்ள உரிமைகள் என்ன என்பதை இந்த அறிவிப்பு விளக்குகிறது.",
      "privacy.collect": "நாங்கள் சேகரிப்பது என்ன",
      "privacy.collectIntro": "உங்கள் விருந்தினருக்காக Form C / Form III (வெளிநாட்டவர் பதிவு) தாக்கல் செய்யத் தேவையான குறைந்தபட்ச தரவை மட்டுமே Cformly சேகரிக்கிறது:",
      "privacy.collect1": "<strong>விருந்தினர் பாஸ்போர்ட் தரவு:</strong> முழு பெயர், குடும்பப் பெயர், தந்தை/முதல் பெயர்கள், பாலினம், பிறந்த தேதி, தேசியம், பாஸ்போர்ட் எண், வழங்கிய இடம்/தேதி, காலாவதி. சாதனத்தில் உள்ள திறந்த மூல OCR மூலம் பாஸ்போர்ட்டின் MRZ வரிசையிலிருந்து படிக்கப்படுகிறது — <strong>எந்தச் சர்வரிலும் பதிவேற்றப்படாது</strong>.",
      "privacy.collect2": "<strong>விருந்தினர் விசா தரவு:</strong> விசா எண், வகை, வழங்கிய இடம்/தேதி, காலாவதி. அதே சாதன-OCR மூலம் படிக்கப்படுகிறது — <strong>பதிவேற்றப்படாது</strong>.",
      "privacy.collect3": "<strong>விருந்தினர் புகைப்படம்:</strong> போர்ட்டல் வரம்புகளுக்கு அளவு மாற்றப்பட்டு, சாதனத்தில் மறையாக்கப்பட்டு சேமிக்கப்படுகிறது.",
      "privacy.collect4": "<strong>ஹோஸ்ட்/வணிக சுயவிவரம்:</strong> நிறுவனப் பெயர், முகவரி, FRRO அலுவலக அதிகார எல்லை, தொடர்பு விவரங்கள். ஒருமுறை உள்ளிடப்பட்டு, அனைத்துத் தாக்கல்களிலும் மீண்டும் பயன்படுத்தப்படுகிறது.",
      "privacy.whereStored": "தரவு எங்கு சேமிக்கப்படுகிறது",
      "privacy.where1": "<strong>சாதனத்தில் மறையாக்கப்பட்ட SQLite தரவுத்தளம்</strong> (விசை iOS Keychain / Android Keystore-இல், கிடைக்குமிடத்தில் ஹார்டுவேர்-ஆதரவு). தெளிவான உரையில் ஒருபோதும் இல்லை; கிளவுட் காப்புப்பிரதிகளில் இல்லை.",
      "privacy.where2": "<strong>பின்தளம் (இந்தியப் பிராந்தியம்):</strong> ஹோஸ்ட் கணக்குகள் மற்றும் அங்கீகார டோக்கன்கள் மட்டுமே. <strong>ஆவணத் தரவு என்றுமே இல்லை</strong> — பாஸ்போர்ட்/விசா படங்களோ பிரித்தெடுக்கப்பட்ட புலங்களோ சர்வரைத் தொடுவதே இல்லை.",
      "privacy.howUsed": "எப்படிப் பயன்படுத்துகிறோம்",
      "privacy.use1": "Form C / Form III புலங்களை மதிப்பாய்வு மற்றும் தாக்கலுக்காக முன்கூட்டியே நிரப்ப.",
      "privacy.use2": "நிரப்பப்பட்ட புலங்களை கிளிப்போர்டுக்கோ PDF-க்கோ நகலெடுத்து, போர்ட்டலில் கைமுறையாக ஒட்ட.",
      "privacy.use3": "இலவச உலாவி எக்ஸ்டென்ஷன் மூலம் FRRO போர்ட்டல் படிவத்தைத் தானாக நிரப்ப (ஹோஸ்ட் உலாவியிலேயே இருப்பார்; சர்வர் மாற்றுப்பாதை இல்லை).",
      "privacy.rights": "உங்கள் உரிமைகள் (DPDP சட்டம் 2023)",
      "privacy.right1": "<strong>அணுகல்:</strong> உங்கள் அனைத்துத் தரவையும் இயந்திர-வாசிப்பு JSON ஆக ஏற்றுமதி செய்யலாம் (Settings &gt; Data &amp; Privacy &gt; Export Data).",
      "privacy.right2": "<strong>திருத்தம்:</strong> தாக்கலுக்கு முன் மதிப்பாய்வுத் திரையில் எந்த விருந்தினர் புலத்தையும் திருத்தலாம்.",
      "privacy.right3": "<strong>அழிப்பு:</strong> Settings &gt; Delete Account அனைத்து உள்ளூர் PII, விசைகளையும் நீக்கி சர்வர்-பக்க நீக்கத்தைத் தூண்டும். முடிந்ததும் உறுதிப்படுத்தல் பெறுவீர்கள்.",
      "privacy.right4":
        "<strong>புகார்:</strong> எந்தத் தனியுரிமைக் கவலை அல்லது தரவுக் கோரிக்கைக்கும் <a href=\\\"mailto:dpo@cformly.com\\\">dpo@cformly.com</a> ஐத் தொடர்பு கொள்ளுங்கள்.",
      "privacy.retention": "தரவு தக்கவைப்பு",
      "privacy.retention1": "ஆவணப் புகைப்படங்களும் பிரித்தெடுக்கப்பட்ட புலங்களும் நீங்கள் நீக்கும் வரை சாதனத்திலேயே மறையாக்கப்பட்டு இருக்கும். அவை சாதனத்தை விட்டு வெளியேறுவது நீங்கள் வெளிப்படையாக செய்யும் செயல்கள் மூலமே — சரிபார்த்த புலங்களை FRRO போர்ட்டலுக்கு அனுப்பும்போது, அல்லது ஒரு நகலை ஏற்றுமதி செய்யும்போது — Cformly சர்வருக்கு ஒருபோதும் இல்லை.",
      "privacy.retention2": "கணக்கை நீக்கும்வரை அல்லது ஆப்பை நிறுவல் நீக்கும்வரை மறையாக்கப்பட்ட உள்ளூர் சேமிப்பு நிலைக்கும்.",
      "privacy.crossBorder": "எல்லை தாண்டிய செயலாக்கம்",
      "privacy.crossBorderBody": "அனைத்து ஆவணப் படமெடுப்பும் OCR-உம் முழுக்க ஃபோனிலேயே இயங்குகிறது. விருந்தினரின் பாஸ்போர்ட், விசா, புலத் தரவு Cformly சர்வருக்கு ஒருபோதும் அனுப்பப்படாது, எங்கள் வழியாக எல்லை தாண்டாது; நீங்களே புலங்களை அதிகாரப்பூர்வ FRRO போர்ட்டலுக்கு அனுப்பும்போது அல்லது ஒரு நகலை ஏற்றுமதி செய்யும்போது மட்டுமே அவை சாதனத்தை விட்டு வெளியேறும். ஹோஸ்ட் கணக்குகளும் பிராபர்டி தரவும் (விருந்தினர் அல்லாதவை) மட்டும் இந்தியப் பிராந்தியத்தில் வைக்கப்படுகின்றன.",
      "privacy.consent": "ஒப்புதல்",
      "privacy.consentBody": "Cformly-ஐப் பயன்படுத்துவதன் மூலம் இந்தத் தரவுச் செயலாக்கத்திற்கு நீங்கள் ஒப்புதல் அளிக்கிறீர்கள். கணக்கை நீக்குவதன் மூலம் எப்போது வேண்டுமானாலும் ஒப்புதலைத் திரும்பப் பெறலாம். ஏற்கனவே FRRO-வில் சமர்ப்பிக்கப்பட்ட தாக்கல்களை திரும்பப் பெறுதல் பாதிக்காது (அவை FRRO-வின் சொந்தக் கொள்கைகளுக்கு உட்பட்டவை).",
      "privacy.contactH": "தொடர்பு",
      "privacy.dpoLabel": "தரவு பாதுகாப்பு அதிகாரி:",
      "privacy.securityLabel": "பாதுகாப்பு:",
      "privacy.supportLabel": "ஆதரவு:",
      "meta.privacyTitle": "தனியுரிமைக் கொள்கை — Cformly",
      "meta.privacyDesc": "Cformly தனியுரிமை அறிவிப்பு மற்றும் ஒப்புதல் — DPDP சட்டம் 2023 இணங்குதல். நாங்கள் சேகரிப்பது, தரவு எங்கு சேமிக்கப்படுகிறது, உங்கள் உரிமைகள்.",

      /* terms page */
      "terms.title": "சேவை விதிமுறைகள்",
      "terms.lede": "ஆப், எக்ஸ்டென்ஷன் மற்றும் இந்த இணையதளத்தைப் பயன்படுத்துவது தொடர்பான உங்களுக்கும் Cformly-க்கும் இடையிலான ஒப்பந்தம்.",
      "terms.acceptance": "1. விதிமுறைகளை ஏற்றல்",
      "terms.acceptanceBody":
        "Cformly மொபைல் பயன்பாட்டை (\\\"the App\\\") பதிவிறக்குவதன், நிறுவுவதன் அல்லது பயன்படுத்துவதன் மூலம், இந்தச் சேவை விதிமுறைகளுக்கு (\\\"Terms\\\") நீங்கள் கட்டுப்பட சம்மதிக்கிறீர்கள். இந்த விதிமுறைகளுக்கு சம்மதியில்லை என்றால் ஆப்பைப் பயன்படுத்த வேண்டாம்.",
      "terms.description": "2. சேவையின் விவரம்",
      "terms.descriptionBody":
        "Cformly என்பது ஹோட்டல்கள், கெஸ்ட் ஹவுஸ்கள் மற்றும் தனிப்பட்ட ஹோஸ்ட்களுக்கு (\\\"Hosts\\\") Immigration and Foreigners Act, 2025 மற்றும் தொடர்புடைய விதிகளின் கீழ் தேவையான FRRO Form C (வெளிநாட்டவர் பதிவு / Form III) தயாரிக்கவும் தாக்கல் செய்யவும் உதவும் ஒரு தாக்கல் உதவியாளர்.",
      "terms.disclaimer": "3. முக்கியமான மறுப்பு",
      "terms.disclaimerBold": "<strong>Cformly FRRO (Foreigners Regional Registration Office), Bureau of Immigration அல்லது இந்திய அரசுடன் — தொடர்பும் இல்லை, அங்கீகாரமும் இல்லை, இணைப்பும் இல்லை.</strong>",
      "terms.disclaimerBody": "Cformly ஒரு சுதந்திரமான தாக்கல் உதவியாளர். தாக்கல் செய்யப்படும் அனைத்துத் தகவலின் துல்லியத்திற்கும், நிர்ணயிக்கப்பட்ட காலத்திற்குள் சமர்ப்பிப்பதற்கும், பொருந்தும் அனைத்துச் சட்டங்களுக்கும் இணங்குவதற்கும் சட்டப்பூர்வமான முழுப் பொறுப்பு ஹோஸ்ட்டிடமே உள்ளது.",
      "terms.obligations": "4. ஹோஸ்ட் கடமைகள்",
      "terms.obligation1": "துல்லியமான வணிகப் பதிவு விவரங்களை வழங்குதல்",
      "terms.obligation2": "சமர்ப்பிக்கும் முன் பிரித்தெடுக்கப்பட்ட அனைத்துத் தரவையும் சரிபார்த்தல் (OCR தவறு செய்யலாம்)",
      "terms.obligation3": "விருந்தினரின் தரவு சேகரிப்புக்கு அவர்களின் ஒப்புதல் உள்ளது என்பதை உறுதி செய்தல்",
      "terms.obligation4": "சட்டப்பூர்வமாக நிர்ணயிக்கப்பட்ட காலத்திற்குள் Form C-ஐத் தாக்கல் செய்தல்",
      "terms.obligation5": "தவறான, மோசடி அல்லது துல்லியமற்ற தகவலைத் தாக்கல் செய்ய ஆப்பைப் பயன்படுத்தாதிருத்தல்",
      "terms.privacy": "5. தனியுரிமை மற்றும் தரவுக் கையாளுதல்",
      "terms.privacyBody":
        "ஆப்பைப் பயன்படுத்துவது எங்கள் <a href=\\\"privacy.html\\\">தனியுரிமைக் கொள்கையாலும்</a> ஆளப்படுகிறது. அனைத்து விருந்தினர் தரவும் SQLCipher (AES-256) மூலம் சாதனத்தில் மறையாக்கப்பட்டே சேமிக்கப்படுகிறது; ஆவணப் படமெடுப்பும் OCR-உம் முழுக்க சாதனத்திலேயே. பின்தளத்தில் ஹோஸ்ட் கணக்குகள் (PII அல்லாதவை) மட்டுமே இந்தியாவில் உள்ளன. மூன்றாம் தரப்பு AI சேவைகள் பயன்படுத்தப்படவில்லை.",
      "terms.accuracy": "6. தரவுத் துல்லியம்",
      "terms.accuracyBody": "ஆப் பாஸ்போர்ட், விசாவிலிருந்து தரவைப் பிரித்தெடுக்க OCR-ஐப் பயன்படுத்துகிறது. OCR 100% துல்லியமானது அல்ல. சமர்ப்பிக்கும் முன் ஹோஸ்ட் அனைத்துப் பிரித்தெடுக்கப்பட்ட தரவையும் மதிப்பாய்வு செய்ய வேண்டும்.",
      "terms.liability": "7. பொறுப்பு வரம்பு",
      "terms.liabilityBody":
        "சட்டம் அனுமிக்கும் அதிகபட்ச அளவிற்கு, Cformly எந்தவொரு உத்தரவாதமும் இன்றி \\\"AS IS\\\" நிலையில் வழங்கப்படுகிறது. தாமதமான, துல்லியமற்ற அல்லது முழுமையற்ற Form C தாக்கல்களால் ஏற்படும் தண்டனைகள், அபராதங்கள் அல்லது சட்ட விளைவுகளுக்கு நாங்கள் பொறுப்பல்ல.",
      "terms.contactH": "8. தொடர்பு",
      "terms.grievanceLabel": "தனியுரிமை/புகார்:",
      "terms.governing": "9. நிர்வகிக்கும் சட்டம்",
      "terms.governingBody": "இந்த விதிமுறைகள் இந்தியச் சட்டங்களால் ஆளப்படுகின்றன. ஏதேனும் தகராறுகளுக்கு இந்தியா, மகாராஷ்டிரா, மும்பை நீதிமன்றங்களின் பிரத்தியேக அதிகார வரம்பே பொருந்தும்.",
      "meta.termsTitle": "சேவை விதிமுறைகள் — Cformly",
      "meta.termsDesc": "Cformly சேவை விதிமுறைகள் — ஏற்றல், ஹோஸ்ட் கடமைகள், தரவுத் துல்லியம், பொறுப்பு வரம்பு, நிர்வகிக்கும் சட்டம்.",
    };
